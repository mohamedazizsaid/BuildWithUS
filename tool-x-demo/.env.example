# Copy to .env and fill in. Get these from http://localhost:3001/developers
BUILDER_CLIENT_ID=5e02f209-4d44-4eb7-aad7-f0c01353d70f
BUILDER_CLIENT_SECRET=KUjFgrEgKWT6ZJcjfTNpT5U51T9EgqzVaJn0erVfFKM

# WinTemplate API gateway (REST)
BUILDER_API_URL=http://localhost:3000

# Where users land after saving in WinTemplate
# Must be added to your allowlist (see scripts/set-return-urls.js)
TOOL_X_RETURN_URL=http://localhost:4444/callback

# Extra return URL to register alongside the dev one (e.g. your prod callback).
# Both get registered in one call so dev + prod work simultaneously.
TOOL_X_RETURN_URL_PROD=

# Which of THIS tool's organizations the demo acts as. Sent as
# custom_champ.external_org_ref so the builder isolates templates per org.
# Change this value (e.g. A1, A2) to simulate different organizations.
TOOL_X_ORG_REF=A1

# Port this demo runs on
PORT=4444
