{
  "info": {
    "name": "Winaity Builder — Integration (M2M + Render)",
    "description": "Test the builder integration as an external tool.\n\nFlow: 1) get an org-scoped M2M token, 2) list that org's templates, 3) render one to ready-to-use HTML.\n\nBefore running: set the collection variables `client_id`, `client_secret` (from the /developers page) and `org_ref` (the external_org_ref the template was created under, e.g. org-alpha). `base_url` defaults to the local gateway.\n\nRequests 1 and 2 auto-save `access_token` and `template_id` for the next request, so just run them top to bottom.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "client_id", "value": "" },
    { "key": "client_secret", "value": "" },
    { "key": "org_ref", "value": "org-alpha" },
    { "key": "access_token", "value": "" },
    { "key": "template_id", "value": "" }
  ],
  "item": [
    {
      "name": "1. Get M2M token (scoped to org)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "if (b.access_token) {",
              "  pm.collectionVariables.set('access_token', b.access_token);",
              "  console.log('saved access_token');",
              "}",
              "pm.test('status 200/201', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
              "pm.test('got access_token', () => pm.expect(b.access_token).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": {
          "raw": "{{base_url}}/oauth/token",
          "host": ["{{base_url}}"],
          "path": ["oauth", "token"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": \"{{client_id}}\",\n  \"client_secret\": \"{{client_secret}}\",\n  \"custom_champ\": { \"external_org_ref\": \"{{org_ref}}\" }\n}"
        },
        "description": "Returns an access_token scoped to {{org_ref}}. The org is baked into the token, so /templates is auto-filtered to it. A missing external_org_ref is rejected with HTTP 400."
      }
    },
    {
      "name": "2. List templates (this org)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "const list = b.templates || [];",
              "const pick = list.find(t => String(t.type || '').toLowerCase() === 'email') || list[0];",
              "if (pick) {",
              "  pm.collectionVariables.set('template_id', pick.id);",
              "  console.log('saved template_id =', pick.id, '(' + pick.type + ')');",
              "} else {",
              "  console.log('no templates for this org yet — create one via the builder first');",
              "}",
              "pm.test('status 200', () => pm.expect(pm.response.code).to.eql(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": {
          "raw": "{{base_url}}/templates",
          "host": ["{{base_url}}"],
          "path": ["templates"]
        },
        "description": "Lists templates for the org encoded in the token. Picks an email template (or the first one) and saves its id as template_id."
      }
    },
    {
      "name": "3. Render template -> HTML",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const b = pm.response.json();",
              "pm.test('status 200', () => pm.expect(pm.response.code).to.eql(200));",
              "pm.test('returns compiled html', () => pm.expect(b.html).to.be.a('string').and.to.include('<'));",
              "console.log('subject:', b.subject);",
              "console.log('html length:', (b.html || '').length);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": {
          "raw": "{{base_url}}/templates/{{template_id}}/render",
          "host": ["{{base_url}}"],
          "path": ["templates", "{{template_id}}", "render"]
        },
        "description": "Compiles the template (MJML -> HTML) and returns { id, name, type, subject, html }. The html is email-client-safe and identical to the builder preview.\n\nGotchas:\n- Must be GET (no body).\n- The token's org (external_org_ref) must match the org the template was created under, otherwise 404.\n- Email templates only for now."
      }
    }
  ]
}
