# ──────────────────────────────────────────────────────────────────────────────
# api-gateway/.env.example — Production environment variables
# Set all of these in Render Dashboard → api-gateway → Environment
# ──────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=production

# CORS — comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=https://your-app.vercel.app

# gRPC service URLs (auto-set by Render from render.yaml)
AUTH_SERVICE_URL=auth-service:50055
TEMPLATE_SERVICE_URL=template-service:50054

# AI & Image services
AI_TEMPLATE_SERVICE_URL=https://ai-template-service.onrender.com
IMAGE_PIPELINE_URL=https://image-pipeline.onrender.com

# Stripe (Live keys — set in Render dashboard, never commit)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TAX_RATE_ID=txr_1UE7vQ8TxBKnCf98aX2ogENp
STRIPE_RETURN_URL=https://your-app.vercel.app

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@buildwithus.app

# JWT (must match auth-service JWT_SECRET)
JWT_SECRET=c3VwZXItc2VjcmV0LWtleS1mb3ItdGhlLWJyaWRnZS1hcHBsaWNhdGlvbi1zZWN1cml0eS1hbnRyYQ==

# Storage S3-compatible (100% GRATUIT SANS CARTE BANCAIRE : Backblaze B2)
# Inscription sans CB sur https://www.backblaze.com/b2/cloud-storage.html (10 GB gratuits)
# Créez un bucket public 'templates', puis 'Application Keys' -> Add Key
MINIO_ENDPOINT=s3.eu-central-003.backblazeb2.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your-backblaze-keyID
MINIO_SECRET_KEY=your-backblaze-applicationKey
MINIO_BUCKET=templates