# ──────────────────────────────────────────────────────────────────────────────
# api-gateway/.env.example — Production environment variables
# Set all of these in Render Dashboard → api-gateway → Environment
# ──────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=production

# CORS — comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=https://your-app.vercel.app

# HTTP microservice URLs
AUTH_SERVICE_URL=http://localhost:3001
TEMPLATE_SERVICE_URL=http://localhost:3002

# AI & Image services
AI_TEMPLATE_SERVICE_URL=https://ai-template-service.onrender.com
IMAGE_PIPELINE_URL=https://image-pipeline.onrender.com

# Stripe (Live keys — set in Render dashboard, never commit)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_TAX_RATE_ID=txr_1UE7vQ8TxBKnCf98aX2ogENp
STRIPE_RETURN_URL=https://your-app.vercel.app

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@buildwithus.app

# JWT (must match auth-service JWT_SECRET)
JWT_SECRET=c3VwZXItc2VjcmV0LWtleS1mb3ItdGhlLWJyaWRnZS1hcHBsaWNhdGlvbi1zZWN1cml0eS1hbnRyYQ==

# Storage Cloudinary (100% GRATUIT SANS CARTE BANCAIRE : https://cloudinary.com)
# Inscription sans CB -> Dashboard -> copiez "API Environment variable"
CLOUDINARY_URL=cloudinary://826948159658395:ugHBScB9rskNnKZnk29XC7WOxmY@dhlnfpfen

# Ou avec les 3 cles séparées :
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Fallback Storage (MinIO / S3 - optionnel)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=winaity
MINIO_SECRET_KEY=winaity123
