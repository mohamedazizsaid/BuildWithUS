@startuml seq-invite
skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber

actor "Administrateur" as A
actor "Invité" as I
participant "Interface\n(Frontend)" as F
participant "Passerelle API" as G
participant "Service\nd'authentification" as S
database "auth_db" as DB

A -> F : Saisit l'e-mail + choisit un rôle
F -> G : POST /auth/invite (REST)
G -> S : InviteUser(email, rôle, tenant) (gRPC)

alt L'utilisateur est déjà membre
    S -> DB : Vérifier l'appartenance
    DB --> S : Déjà membre
    S --> G : Erreur (déjà dans l'équipe)
    G --> F : Message d'information
else Invitation possible
    S -> DB : Créer l'invitation (liée au tenant)
    DB --> S : Invitation enregistrée
    S --> G : Lien d'invitation
    G --> F : Confirmation d'envoi
    F --> A : Invitation envoyée

    I -> F : Ouvre le lien + définit son mot de passe
    F -> G : POST /auth/accept-invite (REST)
    G -> S : AcceptInvite(token, mot de passe) (gRPC)
    S -> DB : Créer le compte rattaché au tenant
    DB --> S : Compte créé
    S --> G : Jeton JWT
    G --> F : Accès accordé (cookie sécurisé)
    F --> I : Redirection vers le tableau de bord
end
@enduml
