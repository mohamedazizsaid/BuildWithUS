@startuml uc-users
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Utilisateur" as U
actor "Administrateur" as A
actor "Invité" as I
actor "Super-administrateur" as S

rectangle "Gestion des utilisateurs" {
  usecase "Gérer son profil" as UC1
  usecase "Consulter le profil" as UC2
  usecase "Modifier le profil" as UC3

  usecase "Gérer l'équipe" as UC4
  usecase "Inviter un membre" as UC5
  usecase "Lister les membres" as UC6
  usecase "Attribuer un rôle" as UC7

  usecase "Accepter une invitation" as UC8
  usecase "Superviser les entreprises" as UC9
}

U --> UC1
A --> UC4
I --> UC8
S --> UC9

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>

UC4 ..> UC5 : <<include>>
UC4 ..> UC6 : <<include>>
UC4 ..> UC7 : <<include>>

' L'administrateur possède aussi les capacités d'un utilisateur
A --> UC1
@enduml
