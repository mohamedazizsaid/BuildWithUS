@startuml seq-inscription
skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber

actor "Utilisateur" as U
participant "Interface\n(Frontend)" as F
participant "Passerelle API" as G
participant "Service\nd'authentification" as S
database "auth_db" as DB

U -> F : Remplit le formulaire d'inscription
F -> G : POST /auth/register (REST)
G -> S : Register(...) (gRPC)
S -> DB : Vérifier l'e-mail / le nom d'entreprise

alt E-mail ou entreprise déjà existant
    DB --> S : Existe déjà
    S --> G : Erreur (déjà utilisé)
    G --> F : 409 Conflit
    F --> U : Message d'erreur
else Données valides
    DB --> S : Disponible
    S -> DB : Créer l'entreprise (tenant)
    S -> DB : Créer le compte utilisateur
    DB --> S : Compte créé
    S --> G : Jeton JWT + infos utilisateur
    G --> F : 201 Créé (cookie sécurisé)
    F --> U : Redirection vers le tableau de bord
end
@enduml
