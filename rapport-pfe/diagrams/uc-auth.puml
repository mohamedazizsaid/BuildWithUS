@startuml uc-auth
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Utilisateur" as U
actor "Administrateur" as A

rectangle "Authentification et inscription" {
  usecase "S'inscrire" as UC1
  usecase "Créer l'entreprise" as UC2
  usecase "Créer le compte" as UC3
  usecase "Se connecter" as UC4
  usecase "Réinitialiser\nle mot de passe" as UC5
  usecase "Se déconnecter" as UC6
}

U --> UC1
U --> UC4
U --> UC6

A --> UC4
A --> UC6

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC4 ..> UC5 : <<extend>>
@enduml
