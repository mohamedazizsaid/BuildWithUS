# ── CRM demo → WinTemplate (Winaity) integration, against PROD ────────────────
# This app pretends to be a third-party CRM with several organizations. It opens
# the Winaity builder for its users and lists each org's templates — isolated by
# external_org_ref.
#
# Setup:
#   1) Create a client in PROD (one-off):
#        curl -X POST https://api-template-builder.winaity.com/developers/register \
#          -H 'Content-Type: application/json' \
#          -d '{"name":"CRM Demo","email":"you@example.com"}'
#      Copy client_id / client_secret into this file.
#   2) cp .env.example .env  (fill the keys)
#   3) npm install && npm start  → open http://localhost:5555
#   4) Click "Register return URL" once on the Settings page.

# Winaity API gateway (PROD). Use http://localhost:4401 to test against your
# local prod stack on the server, or http://localhost:3000 for the dev stack.
BUILDER_API_URL=https://api-template-builder.winaity.com

# Your client credentials (from step 1)
BUILDER_CLIENT_ID=
BUILDER_CLIENT_SECRET=

# Where users come back to after saving in the builder. Must be allowlisted.
CRM_RETURN_URL=http://localhost:5555/callback

# Port this demo runs on
PORT=5555
