{
  "name": "template-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "proto:sync": "echo \"Using shared packages/proto (no sync needed)\"",
    "prebuild": "npm run proto:clean && npm run proto:generate",
    "build": "nest build && tsc-alias",
    "proto:generate": "mkdir -p proto/generated && cp -r ../../packages/proto/gen/ts/google ./proto/generated/ && cp ../../packages/proto/gen/ts/common.ts ../../packages/proto/gen/ts/template_commands.ts ../../packages/proto/gen/ts/template_queries.ts ./proto/generated/",
    "proto:clean": "rm -rf proto/generated/*",
    "prestart": "npm run proto:sync",
    "start": "nest start",
    "prestart:dev": "npm run proto:sync",
    "start:dev": "nest start --watch",
    "prestart:debug": "npm run proto:sync",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "npm run proto:sync",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
    "typeorm": "typeorm-ts-node-commonjs -d ormconfig.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@nestjs/common": "^11.1.11",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.11",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/microservices": "^11.1.11",
    "@nestjs/platform-express": "^11.1.11",
    "@nestjs/typeorm": "^11.0.0",
    "@winaity/shared-kernel": "file:../packages/shared-kernel",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "consul": "^2.0.1",
    "grpc-health-check": "^2.1.0",
    "pg": "^8.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.10",
    "eslint": "^9.39.2",
    "globals": "^17.1.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.11.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "tsc-alias": "^1.8.16",
    "typescript-eslint": "^8.53.1"
  }
}
