# ============================================================
# Winaity Template Builder — Environment template
# ------------------------------------------------------------
# Copy this file to ".env" in the same folder and fill in REAL
# values. NEVER commit the real ".env" (it is git-ignored).
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=winaity
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=postgres

# --- MinIO (object storage) ---
MINIO_ROOT_USER=winaity
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password

# --- JWT (must be IDENTICAL in auth-service and api-gateway) ---
# 64 hex chars recommended
JWT_SECRET=CHANGE_ME_64_hex_chars

# --- PDF export print token (gateway signs, frontend verifies) ---
# Must be the SAME value on both services.
PRINT_TOKEN_SECRET=CHANGE_ME_64_hex_chars

# --- Email providers ---
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- AI / image services ---
OPENROUTER_API_KEY=
PEXELS_API_KEY=

# ============================================================
# PRODUCTION-ONLY values (used by docker-compose.prod.yml)
# Leave these blank/ignored when running on your laptop.
# ============================================================

# Public host ports — assigned project range: 4400-4499
# Kept inside 4400-4499 (never 9000/9001) so MinIO never clashes with another
# MinIO already using host ports 9000/9001.
FRONTEND_PUBLIC_PORT=4400
GATEWAY_PUBLIC_PORT=4401
MINIO_PUBLIC_PORT=4402
AI_PUBLIC_PORT=4403
IMAGE_PUBLIC_PORT=4404
MINIO_CONSOLE_PORT=4405

# Database schema auto-sync for auth-service. KEEP "false".
# Set to "true" ONLY for the first deploy on an empty DB (to create tables),
# then set back to "false" and redeploy.
DB_SYNC=false

# The PUBLIC address users' browsers use to reach the API gateway (port 4401).
# Example with a domain:  https://templates.mycompany.com
# Example with server IP: http://SERVER_IP:4401
PUBLIC_API_URL=http://CHANGE_ME:4401

# The PUBLIC address the browser uses to load uploaded images from MinIO (4402).
# Example: http://SERVER_IP:4402   (or behind your reverse proxy)
MINIO_PUBLIC_URL=http://CHANGE_ME:4402

# The PUBLIC address the browser uses for AI generation (4403) and image search (4404).
PUBLIC_AI_SERVICE_URL=http://CHANGE_ME:4403
PUBLIC_IMAGE_SEARCH_URL=http://CHANGE_ME:4404

# The browser origin allowed to call the AI service (your frontend's public URL).
# Must match how users open the site. Example: http://SERVER_IP:4400
FRONTEND_ORIGIN=http://CHANGE_ME:4400
# Public builder URL used to build integration redirect links (/s/<token>).
# Usually the same as your public frontend origin.
FRONTEND_PUBLIC_URL=http://CHANGE_ME:4400

# Convex (real-time) — public URLs, used by the browser at build time.
NEXT_PUBLIC_CONVEX_URL=https://optimistic-starfish-376.eu-west-1.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://optimistic-starfish-376.eu-west-1.convex.site

# --- Stripe (subscriptions / billing) ---
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
# Where Stripe sends the customer back after payment (defaults to FRONTEND_PUBLIC_URL).
STRIPE_RETURN_URL=http://CHANGE_ME:4400
# French TVA (20%). Create a Tax Rate in the Stripe Dashboard (Products → Tax
# rates → 20%, "exclusive", region France) and paste its id here. Must equal
# frontend VAT_RATE in frontend/lib/plans.ts. Empty ⇒ prices charged HT-only.
STRIPE_TAX_RATE_ID=txr_CHANGE_ME
# Publishable key — public, used by the browser for Embedded Checkout.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# --- CRM Gestion payment forwarding ---
# On every subscription payment (invoice.paid), failure (invoice.payment_failed)
# and cancellation, api-gateway POSTs a JSON payload to the CRM.
# Turn OFF (false) to disable entirely.
CRM_FORWARD_ENABLED=false
# The CRM endpoint that receives the payload.
#   real CRM (prod) : https://api-gestion.winaity.com/api/webhook/abonnement
#                     ⚠️ api-gestion.*, never gestion.winaity.com (307 → lost POST)
#   local fake CRM  : http://host.docker.internal:5600/webhook/payments (docker)
#                     http://localhost:5600/webhook/payments            (local)
CRM_API_URL=
#
# Auth — TWO modes, auto-detected:
#   OAuth2 (real CRM): set CRM_TOKEN_URL + CRM_CLIENT_ID + CRM_CLIENT_SECRET.
#   Static key (fake CRM): leave CRM_TOKEN_URL empty and set CRM_API_KEY.
#
# Static Bearer token (fake CRM only).
CRM_API_KEY=dev-crm-api-key
# HMAC secret to sign the raw body (X-Winaity-Signature). Optional — the fake CRM
# verifies it; the real CRM doesn't (leave empty in prod).
CRM_HMAC_SECRET=
# OAuth2 client-credentials (real CRM). client_id/secret come from the CRM's
# "API & Développeurs" screen. Token endpoint in prod:
#   https://api-gestion.winaity.com/oauth/token
# Token is a 1h JWT (cached in-process) and the CRM allows 1000 req/h.
CRM_CLIENT_ID=
CRM_CLIENT_SECRET=
CRM_TOKEN_URL=
# Leave EMPTY — the CRM ignores `scope` and grants the client's configured scopes.
CRM_SCOPE=
# Comma-separated event_type allowlist. The CRM validates strictly (unknown
# event_type ⇒ 400), so only send what it has deployed. Full set once enabled:
#   payment.succeeded,payment.failed,payment.refunded,subscription.updated,subscription.canceled
CRM_EVENTS=payment.succeeded

# --- Cloudflare Tunnel ---
# Token from the Zero Trust dashboard (Networks -> Tunnels -> your tunnel).
# cloudflared runs on the winaity-net bridge and reaches services by name,
# so the public-hostname targets in Cloudflare use container names, e.g.:
#   http://frontend:3000  http://api-gateway:3000  http://minio:9000
#   http://ai-template-service:8001  http://image-pipeline:8002
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME_tunnel_token
