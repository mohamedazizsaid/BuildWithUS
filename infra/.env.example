# ============================================================
# Winaity Template Builder — Environment template
# ------------------------------------------------------------
# Copy this file to ".env" in the same folder and fill in REAL
# values. NEVER commit the real ".env" (it is git-ignored).
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=winaity
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=postgres

# --- MinIO (object storage) ---
MINIO_ROOT_USER=winaity
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_password

# --- JWT (must be IDENTICAL in auth-service and api-gateway) ---
# 64 hex chars recommended
JWT_SECRET=CHANGE_ME_64_hex_chars

# --- PDF export print token (gateway signs, frontend verifies) ---
# Must be the SAME value on both services.
PRINT_TOKEN_SECRET=CHANGE_ME_64_hex_chars

# --- Email providers ---
RESEND_API_KEY=
GMAIL_USER=
GMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- AI / image services ---
OPENROUTER_API_KEY=
PEXELS_API_KEY=
